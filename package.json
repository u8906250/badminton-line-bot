{
  "name": "badminton-line-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:liff": "wrangler pages deploy liff --project-name badminton-liff",
    "db:init": "wrangler d1 execute badminton --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute badminton --local --file=schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/logic.test.mts && tsx test/manage.test.mts && tsx test/ledger.test.mts && tsx test/notify.test.mts && tsx test/feedback.test.mts && tsx test/cron.test.mts"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0",
    "tsx": "^4.19.0"
  }
}
